_differences":"","important_exceptions":"","tax_year":"2026","sources":[{"title":"Niue Income Tax Act 1961 (consolidated, Niue Legislation Act 2019 edition)","url":"https://mof.gov.nu/wp-content/uploads/2024/04/IncomeTax_1961.pdf","publisher":"Niue Ministry of Finance","kind":"legislation","accessed":"2026-10-15"}],"verified_on":"2026-10-15","confidence":"medium","verification":"partially_verified","open_questions":["Amendments after the 2019 consolidation not checked."],"headline_rate":0.0,"rates":{"listed_securities_domestic":0.0,"listed_securities_foreign":0.0,"private_business_sale":0.0,"real_estate_local":0.0,"real_estate_foreign":0.0},"rate_basis":"Income Tax Act 1961: profits from the sale of property are assessable only when the business is dealing, the property was acquired for resale, or under a profit-making scheme. An investor's gains are therefore scored at 0.","professional_trader":"Dealing in securities makes gains ordinary income at up to 30%.","holding_period_rules":"","foreign_assets":"Same rule for foreign assets."},"dividends":{"status":"researched","basis":"law_in_force","summary":"Income Tax Act 1961 s.49(1)(d) exempts 'dividends and other profits derived from shares… in companies other than companies which are exempt from income tax'. Under s.40 they still count when setting the rate on other assessable income. The current TF1 return nevertheless asks for dividends as income.","exemptions_thresholds":"","eligibility_conditions":"","regional_differences":"","important_exceptions":"","tax_year":"2026","sources":[{"title":"Niue Income Tax Act 1961 (consolidated, Niue Legislation Act 2019 edition)","url":"https://mof.gov.nu/wp-content/uploads/2024/04/IncomeTax_1961.pdf","publisher":"Niue Ministry of Finance","kind":"legislation","accessed":"2026-10-15"},{"title":"Niue Tax Office: TF1 Individual Income Tax Return","url":"https://mof.gov.nu/wp-content/uploads/2024/06/TF1-Inidividual-Income-Tax-Form.pdf","publisher":"Niue Ministry of Finance","kind":"tax_authority","accessed":"2026-10-15"}],"verified_on":"2026-10-15","confidence":"low","verification":"partially_verified","open_questions":["Conflict between the statutory dividend exemption (s.49(1)(d)) and the TF1 return listing dividends as income; Tax Office practice not confirmed.","Whether dividends from foreign companies qualify for the exemption is not explicit."],"headline_rate":0.0,"domestic_rate":0.0,"foreign_gross_rate":0.0,"foreign_tax_credit":"not_applicable","rate_basis":"Statutory exemption, s.49(1)(d); s.40(2)(c) refers to dividends 'derived by an absentee from sources out of Niue', which implies foreign dividends are within the exemption too. Scored at 0. Low confidence because the Tax Office's TF1 form lists 'DIVIDENDS' among income and the exemption's application to foreign companies is not explicit.","withholding_outbound":"Not researched.","treaty_network":"No comprehensive tax treaties (s.85 allows agreements with other countries).","holding_company_notes":""},"wealth_tax":{"status":"researched","basis":"law_in_force","summary":"No net wealth tax. The Niue Tax Office administers income tax, consumption tax (NCT), business licensing and company registration.","exemptions_thresholds":"","eligibility_conditions":"","regional_differences":"","important_exceptions":"","tax_year":"2026","sources":[{"title":"Niue Tax Office (Ministry of Finance): taxes administered, forms and guides","url":"https://mof.gov.nu/niuetax/","publisher":"Niue Ministry of Finance","kind":"tax_authority","accessed":"2026-10-15"}],"verified_on":"2026-10-15","confidence":"medium","verification":"partially_verified","open_questions":[],"type":"none","components":[],"property_tax_note":"No property tax found; most land is customary land."},"inheritance":{"status":"researched","basis":"none","summary":"No estate, inheritance or gift duty was found among the taxes administered by the Niue Tax Office.","exemptions_thresholds":"","eligibility_conditions":"","regional_differences":